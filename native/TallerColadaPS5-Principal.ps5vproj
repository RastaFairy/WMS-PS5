e==5 || texture==6 || (texture>=16 && texture<=24);\n    }\n    int selected_care_texture() const {\n        return basket_icon(selected_mission_,care_label_slot_);\n    }\n    void move_care_label_slot(int delta) {\n        for (int attempt=0;attempt<4;++attempt) {\n            care_label_slot_=(care_label_slot_+delta+4)%4;\n            if (is_garment_texture(selected_care_texture())) { queue_sound(hui::audio::Cue::focus); return; }\n        }\n        queue_sound(hui::audio::Cue::error);\n    }\n    void open_care_label() {\n        if (selected_mission_ >= 12 && !is_expert_mission(selected_mission_)) { set_message(ui_text(UiText::care_label_wash_only),2); queue_sound(hui::audio::Cue::error); return; }\n        int preferred=(focus_id_>=0 && focus_id_<=3)?focus_id_:0;\n        int slot=preferred;\n        if (!is_garment_texture(basket_icon(selected_mission_,slot))) {\n            bool found=false;\n            for (int i=0;i<4;++i) if (is_garment_texture(basket_icon(selected_mission_,i))) { slot=i; found=true; break; }\n            if (!found) { set_message(ui_text(UiText::care_label_select_item),2); queue_sound(hui::audio::Cue::error); return; }\n        }\n        care_label_slot_=slot; care_label_open_=true; queue_sound(hui::audio::Cue::modal_open);\n    }\n    int care_language() const { return rendered_language(language_); }\n    void draw_care_label(DrawList &draw) const {\n        const int texture=selected_care_texture();\n        const GarmentCareSpec *spec=garment_care_spec(texture);\n        draw.rounded_rect(Rect{375,154,1170,754},28,Color::rgb(0xffffff,0.98f));\n        draw.bordered_rect(Rect{375,154,1170,754},28,Color::rgb(0xffffff),2,Color::rgb(0x9abacb));\n        draw.rounded_rect(Rect{410,180,9,52},4,Color::rgb(0x2a9bc0));\n        text(draw,kCareTitle[care_language()],438,208,22,kBlue,true);\n        text(draw,localized_texture_label(texture,selected_mission_,care_label_slot_,language_),438,250,28,kInk,true);\n        image(draw,texture,Rect{4