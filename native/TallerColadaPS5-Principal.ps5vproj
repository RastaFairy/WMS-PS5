n    const char *manual_body(int page) const {\n        return simulation_manual_view_?kSimulationManualPages[rendered_language(language_)][clamp_int(page,0,kSimulationManualPageCount-1)]:kManualPages[rendered_language(language_)][clamp_int(page,0,5)];\n    }\n    void draw_manual(DrawList &draw) const {\n        draw.rounded_rect(Rect{0,0,1920,1080},0,Color::rgb(0x132d40,0.40f));\n        panel(draw,Rect{315,200,1290,680},0xffffff,0xbfd4df,30);\n        draw.rounded_rect(Rect{350,235,10,68},5,Color::rgb(0x2a9bc0));\n        text(draw,simulation_manual_view_?sim_text(SimText::manual):ui_text(UiText::manual_heading),383,263,15,kBlue,true);\n        text(draw,manual_title(manual_page_),383,324,28,kInk,true);\n        const int page_count=manual_page_count();\n        text(draw,std::string(ui_text(UiText::manual_section))+\" \"+format_int(manual_page_+1)+\" / \"+format_int(page_count),1535,324,13,kMuted,true,true);\n        if (simulation_manual_view_) {\n            wrapped_text_box(draw,manual_body(manual_page_),Rect{383,380,1128,350},18,Color::rgb(0x2e4a5b),10,false,false);\n            if (simulation_active_) text(draw,sim_text((simulation_manual_read_mask_&(1u<<static_cast<unsigned int>(manual_page_)))!=0u?SimText::manual_read:SimText::manual_unread),383,759,12,kBlue,true);\n        } else {\n            wrapped_text(draw,manual_body(manual_page_),383,393,21,Color::rgb(0x2e4a5b),79,8);\n        }\n        const float indicators_x=960.0f-static_cast<float>(page_count)*36.5f;\n        for (int i=0;i<page_count;++i) draw.rounded_rect(Rect{indicators_x+i*73.0f,778,56,8},4,Color::rgb(i==manual_page_?0x2a9bc0:0xd5e4ec));\n        const hui::ui::Hint hints[]={{hui::ui::Button::left_stick,ui_text(UiText::manual_change_page)},{hui::ui::Button::cross,ui_text(UiText::manual_close)},{hui::ui::Button::circle,ui_text(UiText::back)}};\n        hui::ui::HintLayout layout; layout.size=31; layout.text_size=20; layout.cy=835; layout.item_gap=30;\n        hui::ui::draw_hints(draw,con