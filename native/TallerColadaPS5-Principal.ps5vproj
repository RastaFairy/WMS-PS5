rt_machine?\"GIRBAU HS-6008 · LOGI PRO\":ui_text(UiText::washer),68,177,expert_machine?13:17,expert_machine?Color::rgb(0x9a6711):kBlue,true);\n        text(draw,running_?cycle_stage():ui_text(UiText::ready_to_use),625,177,13,running_?kCyan:kMuted,true,true);\n        // Use the realistic HS-6008 body/door texture as the base. Only the controls that\n        // respond to gameplay are overdrawn; metal, badge, hinges and door rim remain textured.\n        image_resource(draw,0,Rect{122,201,470,714});\n        // Darken the real LOGI PRO fascia enough for stateful controls to remain legible.\n        draw.rounded_rect(Rect{142,219,430,127},12,Color::rgb(expert_machine?0x121f27:0x182630,0.88f));\n        // Front detergent drawer: I = prewash, II = main wash, F = softener in this simulator.\n        draw.rounded_rect(Rect{153,244,133,51},9,Color::rgb(0xc8d3da));\n        draw.bordered_rect(Rect{153,244,133,51},9,Color::rgb(0xf6fafc),1.5f,Color::rgb(0xaebdc6));\n        if (drawer_anim_ < 0.72f) {\n            draw.rounded_rect(Rect{173,260,92,17},5,Color::rgb(0x899ca8));\n            draw.rounded_rect(Rect{176,262,86,6},3,Color::rgb(0xdfe7ec));\n        }\n        if (drawer_anim_ > 0.01f) {\n            const float tray_x=153.0f+drawer_anim_*18.0f;\n            const float tray_y=244.0f+drawer_anim_*15.0f;\n            draw.rounded_rect(Rect{tray_x+2,tray_y+5,132,52},7,Color::rgb(0x8ea0ab,0.22f));\n            draw.rounded_rect(Rect{tray_x,tray_y,132,52},7,Color::rgb(0xf8fbfd));\n            draw.bordered_rect(Rect{tray_x,tray_y,132,52},7,Color::rgb(0xeaf2f6),1.2f,Color::rgb(0x8ba3b2));\n            for (int c=0;c<3;++c) {\n                const float x=tray_x+4+c*42.0f;\n                const bool dosed=(c==0&&detergent_i_)||(c==1&&detergent_ii_)||(c==2&&softener_);\n                draw.rounded_rect(Rect{x,tray_y+6,38,39},5,Color::rgb(dosed?0xd2edf8:0xe3eaee));\n                draw.bordered_rect(Rect{x,tray_y+6,38,39},5,Color::rgb(dosed?0xd2edf8:0xe3eaee),1.0f,Color::rgb(0xb9c8d1));\n                text(draw,c==0?\"I\":(c==1?\"II\":\"F\"),x+19,tray_y+28,13,kBlue,true,true);\n                if (dosed) draw.circle(x+30,tray_y+39,3.5f,Color::rgb(0x2a9bc0));\n            }\n        }\n        // LCD overlay uses the actual center-control area, with fitting based on measured font width.\n        draw.rounded_rect(Rect{328,237,84,70},8,Color::rgb(0x122d3a));\n        draw.bordered_rect(Rect{328,237,84,70},8,Color::rgb(0x122d3a),1,Color::rgb(0x5d7683));\n        const char *power_label = !plugged_ ? ui_text(UiText::lcd_no_power) : (washer_on_ ? program_name(program_) : ui_text(UiText::lcd_off));\n        fitted_text(draw,power_label,370,257,10,Color::rgb(0x9ff0e0),76,true,true);\n        fitted_text(draw,running_?cycle_stage():(fault_revealed_&&selected_mission_>=12?fault_display_label(selected_mission_):ui_text(UiText::lcd_ready)),370,278,11,Color::rgb(0xffffff),76,true,true);\n        fitted_text(draw,temperature_==0?\"-- C\":format_int(temperature_)+\" C\",370,296,9,Color::rgb(0x96d7ee),59,true,true);\n        // LOGI PRO uses selection/movement keys, not a large rotary knob. Show a small directional pad.\n        draw.rounded_rect(Rect{424,239,56,56},9,Color::rgb(0xd6e1e6));\n        draw.bordered_rect(Rect{424,239,56,56},9,Color::rgb(0xf1f5f7),1.0f,Color::rgb(0x708793));\n        draw.rounded_rect(Rect{443,243,18,13},4,Color::rgb(0x334955));\n        draw.rounded_rect(Rect{443,278,18,13},4,Color::rgb(0x334955));\n        draw.rounded_rect(Rect{429,258,13,18},4,Color::rgb(0x334955));\n        draw.rounded_rect(Rect{462,258,13,18},4,Color::rgb(0x334955));\n        draw.circle(452,267,5,Color::rgb(0x80c9df));\n        // Right-side key/power control, placed where it appears on the product reference.\n        draw.circle(536,268,17,Color::rgb(0x25343d));\n        draw.circle(536,268,12,Color::rgb(washer_on_&&plugged_?0x6aa58a:0x96a5ad));\n        draw.circle(536,268,7,Color::rgb(0xd3dce1));\n        draw.line(536,263,536,270,2.2f,Color::rgb(0x41535d));\n        // Four physical adjustment buttons, all within the actual fascia footprint.\n        const int bx[4]={300,340,380,420};\n        const char *labels[4]={\n            kPhysicalButtonLabels[clamp_int(language_,0,7)][1],\n            kPhysicalButtonLabels[clamp_int(language_,0,7)][2],\n            kPhysicalButtonLabels[clamp_int(language_,0,7)][3],\n            kPhysicalButtonLabels[clamp_int(language_,0,7)][4]\n        };\n        const bool states[4]={false,false,prewash_,extra_rinse_};\n        for (int i=0;i<4;++i) {\n            draw.rounded_rect(Rect{static_cast<float>(bx[i]),305,36,36},7,Color::rgb(states[i]?0xc9eee2:0xf8fafb));\n            draw.bordered_rect(Rect{static_cast<float>(bx[i]),305,36,36},7,Color::rgb(states[i]?0xc9eee2:0xf8fafb),1.0f,Color::rgb(states[i]?0x55ac8f:0xb6c5ce));\n            draw.circle(bx[i]+18,313,3,Color::rgb(states[i]?0x1f7a4d:0x81929d));\n            fitted_text(draw,labels[i],bx[i]+18,333,7.5f,states[i]?kGreen:kMuted,32,true,true);\n        }\n        // START is a game interaction, deliberately outside the physical fascia.\n        draw.rounded_rect(Rect{165,918,385,30},10,Color::rgb(running_?0x8cb6c7:0x1b5f98));\n        draw.bordered_rect(Rect{165,918,385,30},10,Color::rgb(running_?0x8cb6c7:0x1b5f98),1,Color::rgb(0x174b73));\n        fitted_text(draw,running_?ui_text(UiText::cycle_running):ui_text(UiText::start_wash),357,938,13,Color::rgb(0xffffff),350,true,true);\n        // The photo supplies the oval porthole; the animated dark inner drum, laundry and water\n        // are drawn on top so the simulation still reflects loading, filling and running states.\n        const float cx=357.0f, cy=532.0f;\n        draw.circle(cx,cy,88,Color::rgb(0x101e27,0.78f));\n        draw.circle(cx-13,cy-16,72,Color::rgb(0x243741,0.70f));\n        draw.circle(cx-23,cy-31,38,Color::rgb(0x425a66,0.40f));\n        if (water_level_>0.01f) {\n            const float wh=std::min(70.0f,water_level_*108.0f);\n          