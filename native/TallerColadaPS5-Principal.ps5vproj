  "customCode": "// Taller de Colada: native recreation of the original interactive web washer.\n// Generated-screen contract for PS5 Homebrew Studio / OpenGL UI.\n#include \"app/concept.hpp\"\n#include \"audio/cues.hpp\"\n#include \"core/input.hpp\"\n#include \"core/save_file.hpp\"\n#include \"platform/ps5/system.hpp\"\n#include \"gfx/draw_list.hpp\"\n#include \"ui/fonts.hpp\"\n#include \"ui/glyphs.hpp\"\n#include <GL/gl.h>\n#include <algorithm>\n#include <array>\n#include <cmath>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <memory>\n#include <string>\n#include <string_view>\n#include <utility>\n#include <vector>\n\nnamespace hui::concepts {\nnamespace {\nusing hui::gfx::Color;\nusing hui::gfx::Rect;\nusing hui::gfx::DrawList;\n\nconstexpr int kMissionCount = 20; // Original progression and save layout remain unchanged.\nconstexpr int kExpertMissionCount = 5;\nconstexpr int kTotalMissionCount = kMissionCount + kExpertMissionCount;\nconstexpr int kSimulationFaultCount = 5;\nconstexpr int kSimulationFaultsPerCase = 4;\nconstexpr int kSimulationManualPageCount = 4;\nconstexpr int kSimulationAtlasResource = 16;\nconstexpr int kIconCount = 17;\nconstexpr float kPi = 3.1415926535f;\nconst Color kInk = Color::rgb(0x132d40);\nconst Color kMuted = Color::rgb(0x61798a);\nconst Color kBlue = Color::rgb(0x1b4f7a);\nconst Color kCyan = Color::rgb(0x2a9bc0);\nconst Color kGreen = Color::rgb(0x1f7a4d);\nconst Color kAmber = Color::rgb(0xe0a030);\nconst Color kRed = Color::rgb(0xa82019);\n\n// Embedded .huifont blobs are a deterministic fallback for Visual-PS5-generated workspaces,\n// which inject customCode but do not copy arbitrary project assets/fonts/*.huifont files.\n// Source blobs remain in assets/fonts with their original licenses for the standalone build.\nstatic constexpr char kEmbeddedLatinFontBase64[] =\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n    \"\"\n 