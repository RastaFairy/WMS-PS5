stage_rinsing);\n        if (t<0.88f) return ui_text(UiText::stage_draining);\n        return ui_text(UiText::stage_spinning);\n    }\n    void draw_status(DrawList &draw) const {\n        const std::uint32_t color=message_kind_==1?0x1f7a4d:(message_kind_==2?0xb8791a:(message_kind_==3?0xa82019:0x2a9bc0));\n        panel(draw,Rect{712,511,1140,67},message_kind_==1?0xe7f6ed:(message_kind_==3?0xffeeeb:(message_kind_==2?0xfff5e1:0xf1f8fb)),message_kind_==0?0xd6e6ee:color,14);\n        draw.rounded_rect(Rect{724,523,5,43},3,Color::rgb(color));\n        wrapped_text(draw,message_,744,535,14,Color::rgb(0x244253),127,2,message_kind_!=0);\n        if (running_) {\n            const float p=clamp01(cycle_elapsed_/cycle_duration_);\n            draw.rounded_rect(Rect{744,559,1085,5},3,Color::rgb(0xd5e5ed));\n            draw.rounded_rect(Rect{744,559,1085*p,5},3,Color::rgb(0x2a9bc0));\n        }\n    }\n\n    bool service_priority(int id) const {\n        if (simulation_active_) return false;\n        switch (selected_mission_) {\n            case 13: return id==18 || id==19 || id==20 || id==21;\n            case 14: return id==18 || id==19 || id==22 || id==23 || id==24;\n            case 15: return id==18 || id==25 || id==26 || id==27;\n            case 16: return id==18 || id==28;\n            case 17: return id==18 || id==22 || id==25 || id==27;\n            case 18: return id==18 || id==29 || id==30;\n            case 19: return id==19;\n            default: return false;\n        }\n    }\n\n    void draw_service_grid(DrawList &draw) const {\n        // Dedicated opaque workbench region: it replaces basket/status content instead of overlapping it.\n        panel(draw, Rect{700,300,1155,625}, 0xf7fbfd, 0xc9dce6, 22);\n        draw.rounded_rect(Rect{718,316,6,48},3,Color::rgb(0x2a9bc0));\n        text(draw,ui_text(UiText::technical_zone),740,337,19,kBlue,true);\n        wrapped_text(draw,ui_text(UiText::technical_safety),740,357,12,kMuted,96,2);\n        const bool show_spi