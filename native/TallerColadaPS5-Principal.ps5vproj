    for(int i=0;i<kExpertMissionCount;++i){\n            const int row=i/3,col=i%3;\n            const Rect r{56.0f+col*610.0f,326.0f+row*247.0f,588,222};\n            const bool selected=selected_mission_==kMissionCount+i;\n            const bool unlocked=mission_unlocked(kMissionCount+i);\n            panel(draw,r,selected?0xf3fafe:(unlocked?0xffffff:0xf2f5f7),selected?0x2a9bc0:(unlocked?0xcddfe8:0xe0e7eb),18);\n            draw.rounded_rect(Rect{r.x+16,r.y+18,7,r.h-36},4,Color::rgb(unlocked?0xe0a030:0xb9c7cf));\n            draw.circle(r.x+70,r.y+63,34,Color::rgb(unlocked?0xeaf5fa:0xe3e9ed));\n            image(draw,kExpertMissions[i].icons[0],Rect{r.x+43,r.y+36,54,54});\n            text(draw,format_int(i+1)+\" / 5\",r.x+122,r.y+38,13,kBlue,true);\n            wrapped_text_box(draw,mission_title(kMissionCount+i),Rect{r.x+122,r.y+63,r.w-146,43},17,kInk,2,true,false);\n            wrapped_text_box(draw,mission_summary(kMissionCount+i),Rect{r.x+28,r.y+111,r.w-56,40},12,kMuted,2,false,false);\n            wrapped_text_box(draw,mission_goal(kMissionCount+i),Rect{r.x+28,r.y+157,r.w-56,40},12,kInk,2,true,false);\n            if(unlocked){\n                fitted_text(draw,mission_load(kMissionCount+i),r.x+30,r.y+203,11,kBlue,r.w-180,true,false);\n                right_text(draw,format_int(mission_best_stars(kMissionCount+i))+\" \"+ui_text(UiText::stars),r.x+r.w-25,r.y+203,11,kGreen,true);\n            } else {\n                text(draw,expert_text(eu_locked_hint),r.x+30,r.y+203,10,kMuted,false);\n            }\n            if(selected) focus_outline(draw,r);\n        }\n        text(draw,expert_text(eu_mode_hint),960,833,13,kBlue,true,true);\n        draw.rounded_rect(Rect{58,874,1804,10},5,Color::rgb(0xe1edf3));\n        draw.rounded_rect(Rect{58,874,1804.0f*expert_completed_count()/kExpertMissionCount,10},5,Color::rgb(0xe0a030));\n        text(draw,std::string(ui_text(UiText::completed))+\"  \"+format_int(expert_completed_count())+\" / 5\",960,908,13,kBlue,true,true);\n    }\n\n    void draw_menu(DrawList &draw) const {\n        if(expert_mode_view_ && all_missions_complete()) { draw_expert_menu(draw); return; }\n        const int done = completed_count();\n        if (!all_missions_complete()) {\n            const int current = next_unlocked_mission();\n            text(draw,ui_text(UiText::next_mission),50,158,23,kInk,true);\n            wrapped_text(draw,ui_text(UiText::mission_unlock_hint),52,188,16,kMuted,132,2);\n            const Rect card{245,250,1430,560};\n            panel(draw,card,0xffffff,0xcbdde7,28);\n            draw.rounded_rect(Rect{card.x+26,card.y+28,8,card.h-56},4,Color::rgb(kMissions[current].fault?0xe0a030:0x2a9bc0));\n            draw.circle(435,390,104,Color::rgb(0xeaf5fa));\n            image(draw,kMissions[current].icons[0],Rect{345,300,180,180});\n            text(draw,std::string(ui_text(UiText::mission_label_number))+\" \"+format_int(current+1)+\" / 20\",590,325,16,kBlue,true);\n            wrapped_text(draw,mission_title(current),590,379,33,kInk,39,2,true);\n            wrapped_text(draw,mission_summary(current),590,438,19,kMuted,84,3);\n            text(draw,ui_text(UiText::objective_short),590,543,13,kMuted,true);\n            wrapped_text(draw,mission_goal(current),590,575,18,kInk,74,2,true);\n            text(draw,std::string(ui_text(UiText::completed))+\"  \"+format_int(done)+\" / 20\",590,662,16,kBlue,true);\n            draw.rounded_rect(Rect{590,684,970,13},7,Color::rgb(0xe1edf3));\n            draw.rounded_rect(Rect{590,684,970.0f*done/kMissionCount,13},7,Color::rgb(0x2a9bc0));\n            draw.rounded_rect(Rect{590,720,400,54},15,Color::rgb(0x1b5f98));\n            text(draw,ui_text(UiText::start_mission),790,753,17,Color::rgb(0xffffff),true,true);\n            wrapped_text(draw,ui_text(UiText::mission_locked),590,795,13,kMuted,98,1);\n        } else {\n            text(draw,ui_text(UiText::unlock_all),50,158,23,kGreen,true);\n            text(draw,ui_text(UiText::unlock_all_desc),52,