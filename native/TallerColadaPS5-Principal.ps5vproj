bolts_safety, msg_bolts_removed, msg_balance_safety, msg_balance_done, msg_obstruction_safety, msg_obstruction_removed, msg_drawer_clean_safety, msg_drawer_clean, msg_gasket_clean_safety, msg_gasket_clean, msg_mud_safety, msg_mud_removed, msg_cycle_already_running, msg_maintenance_no_cycle, msg_leak_no_cycle, msg_cycle_started, msg_cycle_finished, msg_maintenance_finished, msg_area_secured, msg_program_prefix, msg_no_heating, msg_temperature_prefix, msg_spin_prefix, msg_item_in_drum_suffix, msg_item_out_drum_suffix, hint_prefix, hint_load_items, hint_program_prefix, hint_temperature_prefix, hint_temperature_suffix, hint_dose_ii, hint_prewash, hint_extra_rinse, hint_brush_mud, hint_finish_setup, hint_foam, hint_inlet_fault, hint_drain_fault, hint_installation_fault, hint_door_fault, hint_spin_fault, hint_maintenance, hint_leak, err_no_power, err_power_button, err_open_tap, err_close_door, err_door_obstructed, err_close_filter, err_missing_items, err_wrong_items, err_temperature, err_spin_too_high, err_detergent_missing, err_prewash_missing, err_prewash_dose_missing, err_extra_rinse_missing, err_softener_forbidden, err_brush_before_wash, err_foam_corrective, err_spin_after_drain, err_program_correct_suffix, err_fault_active_prefix, err_fault_active_suffix, msg_fault_display_prefix, msg_fault_display_suffix, hint_program_suffix, tech_priority, state_do_not_touch, lcd_no_power, msg_unplugged_poweroff, msg_unplugged_already_off, msg_power_no_mains, msg_plug_connected_manual, msg_unplug_interrupted, step_connect_power, options_label, unsaved_progress, unsaved_progress_hint, msg_reconnect_wet_floor, care_label, care_label_close, browse_garments, care_label_wash_only, care_label_select_item, care_standard_note, care_original_label_reminder, care_temperature_max_suffix, initial_hint, count };\nstatic constexpr const char *kLanguageNames[8] = {\"Español\", \"English\", \"Français\", \"Русский\", \"Deutsch\", \"日本語\", \"简体中文\", \"Italiano\"};\nstatic constexpr const char *kUiStrings[8][static_cast<std::size_t>(UiText::count)] = {\n    {\"SIMULADOR INTERACTIVO DE LAVADO\", \"Aprende usando la lavadora: prepara la carga, ajusta el ciclo y resuelve averías.\", \"Una lavadora que se aprende usando: prepara la carga, controla el cajón, ajusta el ciclo y diagnostica averías con objetos del aparato.\", \"MENÚ PRINCIPAL\", \"Continuar partida\", \"Nueva partida\", \"Datos guardados\", \"Opciones\", \"Manual de bolsillo\", \"MANUAL DE BOLSILLO\", \"SECCIÓN\", \"Cambiar página\", \"Cerrar manual\", \"Pista\", \"Abrir zona técnica\", \"Continúa donde lo dejaste.\", \"Empieza una carrera nueva. El progreso anterior se reemplazará.\", \"Guarda, carga o elimina tu partida.\", \"Idioma, sonido y ajustes de pantalla.\", \"Gestión de partidas\", \"RANURA 1\", \"PARTIDA GUARDADA\", \"SIN PARTIDA GUARDADA\", \"Progreso\", \"Guardar partida\", \"Cargar partida\", \"Borrar partida\", \"Partida guardada correctamente.\", \"No se pudo guardar la partida.\", \"Partida cargada.\", \"No se pudo cargar la partida.\", \"Partida borrada.\", \"No se pudo borrar la partida.\", \"¿Borrar la partida guardada?\", \"¿Empezar una partida nueva?\", \"Esta acción no se puede deshacer.\", \"Sí, continuar\", \"Cancelar\", \"Opciones restauradas.\", \"Restablecer opciones\", \"Idioma\", \"Volumen de efectos\", \"Brillo de interfaz\", \"Escala de interfaz\", \"ESCALA UI\", \"Guardado automático\", \"Activado\", \"Desactivado\", \"Ajusta el tamaño dentro del área 16:9 sin cambiar la resolución de salida.\", \"El volumen se aplica a los efectos de sonido del juego.\", \"La fuente conserva acentos y caracteres del idioma seleccionado.\", \"Navegar\", \"Seleccionar\", \"Volver\", \"Progreso de misiones\", \"MISIONES\", \"SELECCIÓN LIBRE DESBLOQUEADA\", \"SIGUIENTE MISIÓN\", \"Completa la misión disponible para desbloquear la siguiente. Al completar las 20 podrás elegir cualquiera.\", \"Completadas\", \"Entrar en la misión\", \"Las demás misiones se desbloquean en orden.\", \"LAS 20 MISIONES ESTÁN DISPONIBLES\", \"Selecciona cualquier escenario y repítelo para mejorar tu puntuación.\", \"Todavía no hay progreso guardado.\", \"LAVADORA\", \"LISTA PARA USAR\", \"EN ESPERA\", \"LLENANDO\", \"PRELAVADO\", \"LAVANDO\", \"ACLARANDO\", \"DESAGUANDO\", \"CENTRIFUGANDO\", \"CESTA DE ROPA\", \"Abre la puerta y elige cada prenda con X para cargar o retirar.\", \"CARGA ACTUAL\", \"EN TAMBOR\", \"EN CESTA\", \"DIAGNÓSTICO Y SEGURIDAD\", \"OBJETIVO DE LA COLADA\", \"OBJETOS\", \"CARGA\", \"TIEMPO\", \"OBJETIVO\", \"SIGUIENTE PASO\", \"1. Cargar y cerrar la puerta\", \"1. Abrir puerta para cargar o retirar prendas\", \"2. Encender la lavadora\", \"2. Revisar el programa y los ajustes\", \"3. El tambor está lavando\", \"3. Pulsar Inicio cuando todo esté preparado\", \"II es el lavado principal. I se usa solo con prelavado. Evita sobredosificar; sigue la etiqueta y la dureza del agua.\", \"INICIO DE LAVADO\", \"CICLO EN MARCHA\", \"Cajón abierto. Elige I, II o suavizante.\", \"Cajón cerrado.\", \"Detergente de prelavado en I.\", \"Detergente del lavado principal en II.\", \"Suavizante dosificado.\", \"Suavizante desactivado.\", \"Lavadora encendida.\", \"Lavadora apagada.\", \"PUERTA ABIERTA\", \"PUERTA CERRADA\", \"TAMBOR VACÍO\", \"ZONA TÉCNICA · DIAGNÓSTICO Y MANTENIMIENTO\", \"Seguridad: apaga y desenchufa antes de reparar; no manipules enchufes con agua cerca.\", \"Selecciona un punto y pulsa X para inspeccionar o reparar.\", \"14 PUNTOS\", \"Enchufe\", \"Grifo\", \"Entrada de agua\", \"Filtro de entrada\", \"Desagüe\", \"Bandeja de agua\", \"Filtro de bomba\", \"Patas niveladoras\", \"Tornillos de transporte\", \"Reparto de carga\", \"Cierre de puerta\", \"Cajón detergente\", \"Junta de goma\", \"Barro seco\", \"CONECTADO\", \"DESCONECTADO\", \"ABIERTO\", \"CERRADO\", \"RECTA\", \"PINZADA\", \"LIMPIO\", \"SUCIEDAD\", \"OBSTRUIDA\", \"COLOCADA\", \"SIN BANDEJA\", \"NIVELADA\", \"DESNIVEL\", \"RETIRADOS\", \"PUESTOS\", \"REPARTIDA\", \"DESEQUILIBRIO\", \"LIBRE\", \"OBSTÁCULO\", \"RESIDUOS\", \"BARRO SECO\", \"RETIRADO\", \"MISIÓN\", \"MISIÓN SUPERADA\", \"COLADA\", \"DIAGNÓSTICO\", \"MISIÓN\", \"OBJETIVO\", \"PROGRAMA\", \"VOLVER A LAS MISIONES\", \"PUNTOS\", \"ESTRELLAS\", \"APAGADA\", \"LISTA\", \"TEMP.\", \"Ajustar\", \"Aceptar\", \"Interactuar\", \"Selecciona la siguiente misión disponible.\", \"Cajón abierto. Elige I, II o suavizante.\", \"Cajón cerrado.\", \"Detergente de prelavado en I.\", \"Compartimento I vacío.\", \"Detergente del lavado principal en II.\", \"Compartimento II vacío.\", \"Suavizante dosificado.\", \"Suavizante desactivado.\", \"No apagues la lavadora mientras gira el tambor.\", \"Lavadora encendida.\", \"Lavadora apagada.\", \"Dial activo: stick izquierda/derecha cambia el programa.\", \"Temperatura activa: ajusta hasta respetar la etiqueta.\", \"Centrifugado activo: ajusta las revoluciones.\", \"Prelavado activado: usa detergente en I.\", \"Prelavado desactivado.\", \"Aclarado extra activado.\", \"Aclarado extra desactivado.\", \"Zona técnica abierta. Sigue los pasos de seguridad.\", \"Zona técnica abierta. Antes de tocar conexiones, apaga y desenchufa.\", \"Zona técnica cerrada.\", \"Grifo de entrada abierto.\", \"Grifo de entrada cerrado.\", \"Bandeja colocada bajo el filtro.\", \"Bandeja retirada.\", \"No manipules la carga durante el ciclo.\", \"Abre la puerta antes de meter o sacar prendas.\", \"Tambor lleno. No fuerces más prendas.\", \"La puerta está bloqueada por seguridad. Resuelve el agua o espera al ciclo.\", \"Una prenda bloquea el cierre. Retira el obstáculo desde la zona técnica antes de cerrar.\", \"Puerta cerrada.\", \"Puerta abierta. Puedes cargar o repartir la ropa.\", \"No toques el enchufe con el suelo mojado. Apaga la máquina y cierra el grifo sin acercarte al agua.\", \"No desconectes durante el ciclo.\", \"Enchufe conectado.\", \"Desenchufada. Ya puedes trabajar en mangueras y filtros.\", \"Seguridad: apaga y desenchufa antes de tocar una manguera.\", \"Manguera de entrada recta y sin pinzamientos.\", \"Manguera de desagüe recta y sin obstrucciones.\", \"Cierra el grifo, apaga y desenchufa antes de limpiar el filtro de entrada.\", \"Filtro de entrada limpio. Puedes abrir el grifo al terminar.\", \"Apaga y desenchufa antes de abrir el filtro de la bomba.\", \"Coloca primero una bandeja: puede quedar agua residual.\", \"Filtro abierto despacio. Vuelve a interactuar para retirar lo atascado.\", \"Obstrucción retirada y agua recogida en la bandeja.\", \"Filtro cerrado a fondo; puedes reconectar cuando todo esté seco.\", \"Apaga y desenchufa antes de ajustar las patas.\", \"Patas niveladas. La máquina ya apoya sin balanceo.\", \"Apaga y desenchufa antes de retirar los tornillos de transporte.\", \"Tornillos de transporte retirados.\", \"Apaga la máquina y abre la puerta antes de repartir la carga.\", \"Carga repartida por el tambor, sin una bola en un solo lado.\", \"Apaga la máquina y abre la puerta para revisar la junta y el cierre.\", \"Obstáculo retirado. Cierra la puerta sin forzarla.\", \"Apaga la máquina y extrae el cajón antes de limpiarlo.\", \"Cajón limpio; los compartimentos están despejados.\", \"Deja el tambor vacío, abre la puerta y apaga antes de limpiar la junta.\", \"Junta limpiada. Deja la puerta abierta para ventilar.\", \"Apaga la lavadora y abre la puerta para retirar el barro seco de las prendas.\", \"Barro seco retirado en seco antes del lavado; protege la bomba.\", \"El ciclo ya está en marcha.\", \"Esta misión se completa limpiando el cajón y la junta, sin iniciar un ciclo.\", \"No inicies otro ciclo: apaga la máquina y cierra el grifo para contener la fuga.\", \"Ciclo en marcha. Observa el nivel de agua, el tambor y las fases en la pantalla.\", \"Ciclo terminado. La puerta se desbloquea; revisa el resultado de la colada.\", \"Mantenimiento terminado: cajón y junta limpios; deja ventilar la máquina.\", \"Zona asegurada: máquina apagada y grifo cerrado. No toques el enchufe con el suelo mojado.\", \"Programa: \", \"Sin calentamiento de agua.\", \"Temperatura: \", \"Centrifugado: \", \" dentro del tambor.\", \" fuera del tambor.\", \"PISTA: \", \"Abre la puerta y deja en el tambor solo las prendas compatibles que exige esta misión.\", \"Gira el dial a \", \"Ajusta la temperatura según la etiqueta; esta misión necesita \", \" °C.\", \"Abre el cajón y dosifica detergente en II.\", \"Activa el prelavado y coloca detergente en I.\", \"Activa Aclarado extra.\", \"Apaga la máquina, abre la puerta y retira el barro seco antes de lavar.\", \"Cierra la puerta, enciende y pulsa Inicio.\", \"Elige Aclarado, activa el aclarado extra y no añadas más detergente.\", \"Apaga y desenchufa; cierra el grifo para limpiar el filtro de entrada. Revisa la manguera.\", \"Desenchufa, coloca la bandeja, abre despacio el filtro, retira la obstrucción y cierra antes de reconectar.\", \"Retira los tornillos de transporte y nivela las patas con la máquina apagada y desenchufada. Reparte la carga.\", \"Apaga y desenchufa. Abre la puerta, retira el obstáculo y cierra sin forzar.\", \"Revisa el desagüe y reparte la carga; después usa Centrifugar.\", \"Abre el cajón y la puerta con el equipo apagado; limpia ambos y deja ventilar.\", \"Apaga la máquina y cierra el grifo. No toques el enchufe ni el aparato mojado.\", \"La máquina no tiene corriente: conecta el enchufe cuando sea seguro.\", \"Pulsa el control de encendido de la lavadora.\", \"Abre el grifo de entrada antes de iniciar el ciclo.\", \"Cierra la puerta antes de iniciar el ciclo.\", \"La puerta no bloquea: retira la prenda que estorba y vuelve a cerrar.\", \"Cierra el filtro y retira la bandeja antes de iniciar.\", \"Faltan prendas necesarias. Revisa la etiqueta y la cesta.\", \"Hay prendas incompatibles en el tambor. Separa color y tejido.\", \"La temperatura no coincide con el objetivo o supera las etiquetas de esta carga.\", \"El centrifugado es demasiado alto para esta carga.\", \"Falta detergente de lavado principal en el compartimento II.\", \"Esta carga necesita prelavado y detergente en el compartimento I.\", \"Has activado el prelavado, pero falta detergente en I.\", \"Activa el aclarado extra para retirar mejor los residuos.\", \"Evita el suavizante: puede perjudicar este tejido delicado o técnico.\", \"Retira primero el barro seco; evita enviar sólidos a la bomba.\", \"Para eliminar la espuma: Aclarado, aclarado extra y no añadas más detergente.\", \"Selecciona Centrifugar después de corregir el desagüe y repartir la carga.\", \" es el programa correcto. Ajusta el dial.\", \"La avería sigue activa: \", \". Usa la zona técnica y el manual.\", \"DISPLAY: \", \". Investiga la causa en la zona técnica antes de reiniciar.\", \".\", \"OBJETIVO\", \"NO TOCAR\", \"SIN CORRIENTE\", \"Enchufe desconectado: la lavadora queda apagada automáticamente.\", \"Desenchufada. La lavadora está apagada; puedes trabajar en mangueras y filtros.\", \"No hay alimentación. Conecta el enchufe antes de encender la lavadora.\", \"Enchufe conectado. Enciende la lavadora manualmente cuando sea seguro.\", \"La alimentación se ha interrumpido. Hay agua en el tambor; revisa la situación antes de continuar.\", \"Conectar el enchufe antes de encender\", \"OPCIONES\", \"PROGRESO SIN GUARDAR\", \"Guarda desde Datos guardados antes de cerrar el juego.\", \"No reconectes la lavadora mientras el suelo esté mojado. Espera a que la zona quede seca.\", \"Etiqueta de cuidado (R3)\", \"Cerrar etiqueta (R3)\", \"Cambiar prenda\", \"Las fichas de cuidado están disponibles en misiones de colada.\", \"Selecciona una prenda de la cesta para consultar su etiqueta.\", \"ISO 3758: los símbolos de cuidado textil indican lavado, blanqueo, secado, planchado y cuidado profesional.\", \"Consulta siempre la etiqueta original cosida en la prenda.\", \"°C máx.\", \"Elige una opción para continuar.\"},\n    {\"INTERACTIVE WASHING SIMULATOR\", \"Learn by using the washer: load laundry, set the cycle and solve faults.\", \"Learn by doing: prepare the load, use 